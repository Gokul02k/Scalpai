# Optional — Finnhub (Indian indices use Yahoo Finance by default)
FINNHUB_API_KEY=your_finnhub_api_key_here

# AI — Gemini (free tier at https://aistudio.google.com/apikey) — used for Ask EA + chat
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — Anthropic fallback for chat if Gemini is not set
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional — override Gemini model (default: gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash
