# Optional — Finnhub (Indian indices use Yahoo Finance by default)
FINNHUB_API_KEY=your_finnhub_api_key_here

# ── AI provider (Ask EA + chat) ──────────────────────────────────────────────
# auto = use first configured provider below (Groq → Ollama → Gemini → Anthropic)
AI_PROVIDER=auto

# Easiest free cloud option (works on Vercel): https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# Local free option (dev only — Vercel cannot reach your PC): https://ollama.com
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# Google Gemini — AIza… or AQ.… key from https://aistudio.google.com/apikey
# Note: new keys often show "quota exceeded" on first prompt until billing is linked (free tier still free).
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# Optional — Anthropic fallback
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Force a single provider, e.g. AI_PROVIDER=groq
