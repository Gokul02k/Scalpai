# Optional — Finnhub (Indian indices use Yahoo Finance by default)
FINNHUB_API_KEY=your_finnhub_api_key_here

# AI — Groq (free at https://console.groq.com) — Ask EA and chat (portfolio edits via chat commands)
GROQ_API_KEY=your_groq_api_key_here

# Optional — default model when chat UI has no selection (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Background NIFTY signal log (runs on server every 2 min during market hours, even when app is closed)
# Create a free Upstash Redis database: https://console.upstash.com — then add via Vercel → Storage → Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret for /api/nifty-log/cron — Vercel Cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your_random_secret_here
