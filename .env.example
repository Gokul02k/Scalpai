# Optional — Finnhub (Indian indices use Yahoo Finance by default)
FINNHUB_API_KEY=your_finnhub_api_key_here

# AI — primary provider: Google Gemini (free key at https://aistudio.google.com/apikey)
# Powers Ask EA + chat (portfolio edits via chat commands). Use a standard key that starts with "AIza".
GEMINI_API_KEY=your_gemini_api_key_here
# Optional — default Gemini model when chat UI has no selection (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# AI — fallback provider: Groq (free at https://console.groq.com).
# Used automatically only if Gemini has no key or errors. Optional but recommended for reliability.
GROQ_API_KEY=your_groq_api_key_here
# Optional — default Groq fallback model
# GROQ_MODEL=llama-3.3-70b-versatile

# Background NIFTY signal log (syncs to Upstash when app is open; optional server cron on Vercel Pro)
# Create a free Upstash Redis database: https://console.upstash.com — then add via Vercel → Storage → Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret for /api/nifty-log/cron — Vercel Cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your_random_secret_here

# Vercel Hobby allows only once-per-day crons (deploy fails on */2 * * * *).
# On Vercel Pro, merge vercel.cron.pro.example.json into vercel.json for 2-minute logging.
